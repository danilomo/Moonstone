<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Moonstone" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Light status bar (dark icons) -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Moonstone.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Moonstone</item>
    </style>
</resources>
